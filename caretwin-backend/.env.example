NODE_ENV=development
PORT=4000

# Comma-separated frontend origins (never use *)
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://caretwin:caretwin@localhost:5432/caretwin?schema=public
REDIS_URL=redis://localhost:6379

# Optional: leave empty in local dev if you are not using Sentry yet
SENTRY_DSN=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# AI chat (add a valid provider key; keep it private)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Alternatively, set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.

ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=change-me
