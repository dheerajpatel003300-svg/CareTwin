NODE_ENV=production

# Your real frontend origin(s), https only, comma separated
CORS_ORIGINS=
FRONTEND_URL=

# Managed Postgres (dedicated role, not postgres, no CREATEDB) and Redis
DATABASE_URL=
REDIS_URL=

# 48+ random bytes each: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Refresh cookie. Behind the Vercel proxy the browser sees /api/auth.
COOKIE_SAMESITE=strict
COOKIE_PATH=/api/auth
TRUST_PROXY_HOPS=2

# Supabase Storage S3-compatible connection; use a private bucket and project S3 keys.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: smtp, or a provider with SPF/DKIM on your own domain
MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# AI chat
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ML service: HTTPS origin only, with no trailing slash.
ML_SERVICE_URL=
# Must match the ML service ML_API_KEY.
ML_SERVICE_API_KEY=

# Monitoring (check what it sends: this app handles health data)
SENTRY_DSN=
